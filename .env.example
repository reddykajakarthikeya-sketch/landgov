# Environment Variables Template
PROJECT_NAME="National Digital Platform for Land Governance"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (Defaults to SQLite; supports PostgreSQL)
# DATABASE_URL="postgresql://user:password@localhost:5432/landgov"
DATABASE_URL=""

# JWT Security
SECRET_KEY="replace-with-your-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Optional: system operates in grounded domain heuristic mode if omitted)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
